<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".secondActivity">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="הנתונים שנשלחו"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="40dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvOutFirstName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="שם פרטי: "
        android:textSize="18sp"
        android:layout_marginTop="40dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvOutAge"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="גיל: "
        android:textSize="18sp"
        android:layout_marginTop="20dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintTop_toBottomOf="@id/tvOutFirstName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvOutMale"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="זכר?: "
        android:textSize="18sp"
        android:layout_marginTop="20dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintTop_toBottomOf="@id/tvOutAge"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <!-- שנת לידה -->
    <TextView
        android:id="@+id/tvBirthYearLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="שנת לידה:"
        android:textSize="16sp"
        android:layout_marginTop="32dp"
        android:layout_marginStart="24dp"
        app:layout_constraintTop_toBottomOf="@id/tvOutMale"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/etBirthYear"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:hint="לדוגמה: 2000"
        android:inputType="number"
        android:layout_marginStart="12dp"
        app:layout_constraintBaseline_toBaselineOf="@id/tvBirthYearLabel"
        app:layout_constraintStart_toEndOf="@id/tvBirthYearLabel" />

    <Button
        android:id="@+id/btnOk"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="OK"
        android:layout_marginTop="20dp"
        android:layout_marginStart="24dp"
        app:layout_constraintTop_toBottomOf="@id/tvBirthYearLabel"
        app:layout_constraintStart_toStartOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>
